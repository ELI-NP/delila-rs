[Unit]
Description=Mesytec MHV-4 HV monitor (read-only, Si bias) -> InfluxDB
# Independent of the DAQ: no ordering or dependency on any DAQ service.
After=network.target

[Service]
User=daq
# The serial port is root:dialout 0660.
SupplementaryGroups=dialout
WorkingDirectory=/home/daq/delila-rs/tools/hv_monitor
ExecStart=/usr/bin/python3 -u mhv4_monitor.py --config mhv4_config.yaml
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
