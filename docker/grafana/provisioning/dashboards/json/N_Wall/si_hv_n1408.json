          "rawSql": "SELECT time, concat('ch', CAST(channel AS VARCHAR), ' ', message) AS text\nFROM n1408_event\nWHERE time >= $__timeFrom AND time <= $__timeTo AND action = 'status_change' AND regexp_like(message, 'new: \\[[^]]*(TRIP|KILL|ILK|OVC|OVV|OVP|OVT)')\nORDER BY time",
          "query": "SELECT time, concat('ch', CAST(channel AS VARCHAR), ' ', message) AS text\nFROM n1408_event\nWHERE time >= $__timeFrom AND time <= $__timeTo AND action = 'status_change' AND regexp_like(message, 'new: \\[[^]]*(TRIP|KILL|ILK|OVC|OVV|OVP|OVT)')\nORDER BY time",
