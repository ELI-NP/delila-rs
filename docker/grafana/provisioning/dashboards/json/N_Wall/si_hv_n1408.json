          "rawSql": "SELECT time, concat('ch', CAST(channel AS VARCHAR), ' ', action, ' by ', operator) AS text\nFROM n1408_event\nWHERE time >= $__timeFrom AND time <= $__timeTo AND action IN ('on', 'off', 'set') AND result = 'done'\nORDER BY time",
          "query": "SELECT time, concat('ch', CAST(channel AS VARCHAR), ' ', action, ' by ', operator) AS text\nFROM n1408_event\nWHERE time >= $__timeFrom AND time <= $__timeTo AND action IN ('on', 'off', 'set') AND result = 'done'\nORDER BY time",
