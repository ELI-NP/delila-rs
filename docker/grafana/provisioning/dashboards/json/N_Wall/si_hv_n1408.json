          "rawSql": "SELECT channel, CASE WHEN status IS NULL THEN NULL WHEN (status & 2048) <> 0 THEN 8 WHEN (status & 4096) <> 0 THEN 7 WHEN (status & 128) <> 0 THEN 6 WHEN (status & 1) = 0 THEN CASE WHEN (status & 1024) <> 0 THEN 5 ELSE 0 END WHEN (status & 4) <> 0 THEN 3 WHEN (status & 2) <> 0 THEN 2 WHEN (status & 32) <> 0 THEN 1 WHEN vmon IS NULL OR vset IS NULL OR vmon < vset - 2.5 THEN 4 ELSE 1 END AS state, vmon, vset, imon, iset, maxv, rup, rdw, trip, trim(concat(CASE WHEN (status & 8) <> 0 THEN 'OVC ' ELSE '' END, CASE WHEN (status & 16) <> 0 THEN 'OVV ' ELSE '' END, CASE WHEN (status & 32) <> 0 THEN 'UNV ' ELSE '' END, CASE WHEN (status & 64) <> 0 THEN 'MAXV ' ELSE '' END, CASE WHEN (status & 128) <> 0 THEN 'TRIP ' ELSE '' END, CASE WHEN (status & 256) <> 0 THEN 'OVP ' ELSE '' END, CASE WHEN (status & 512) <> 0 THEN 'OVT ' ELSE '' END, CASE WHEN (status & 1024) <> 0 THEN 'DIS ' ELSE '' END, CASE WHEN (status & 2048) <> 0 THEN 'KILL ' ELSE '' END, CASE WHEN (status & 4096) <> 0 THEN 'ILK ' ELSE '' END, CASE WHEN (status & 8192) <> 0 THEN 'NOCAL ' ELSE '' END)) AS flags, time FROM (SELECT time, channel, status, vmon, vset, imon, iset, maxv, rup, rdw, trip, ROW_NUMBER() OVER (PARTITION BY channel ORDER BY time DESC) AS rn FROM n1408 WHERE time >= now() - interval '1 minute') AS latest WHERE rn = 1 ORDER BY channel",
          "format": "table"
        }
